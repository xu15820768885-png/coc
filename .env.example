# 可选。仅供外部程序自动提交 JSON；网页登录和粘贴 JSON 不需要。
API_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# 企业微信管理后台 -> 我的企业 -> 企业信息 -> 企业 ID
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx

# 企业微信管理后台 -> 应用管理 -> 自建应用
WECOM_AGENT_ID=1000002
WECOM_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 接收成员账号，多个用 | 分隔；@all 表示应用可见范围内所有人
WECOM_TO_USER=@all

# 国内企业微信默认无需修改；如你确实使用消息转发代理再填代理根地址
WECOM_API_BASE=https://qyapi.weixin.qq.com

# 可选：让 Docker 的企业微信请求通过云服务器 HTTP/HTTPS 代理出网。
# 只有普通 FRP/反向隧道时不要填写；它不是 HTTP 出站代理。
OUTBOUND_PROXY=
